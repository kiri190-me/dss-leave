{
  "name": "dss-leave",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3700",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3700",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:down": "docker compose --env-file .env.local down",
    "db:psql": "docker exec -it dss-leave-postgres-dev psql -U dss_leave -d dss_leave",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:ranks": "tsx scripts/seed-ranks.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:menu": "tsx scripts/test-service-menu.ts",
    "test:bell": "tsx scripts/test-notification-bell.ts",
    "test:portal": "tsx scripts/test-portal-notifications.ts",
    "test:leave": "tsx scripts/test-leave-rules.ts",
    "test:workflow": "tsx scripts/test-workflow.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
