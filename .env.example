# ------------------------------------------------------------------
# DSS 휴가 관리 — 환경변수 예시
#
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채운다.
# .env.local 은 git 에 올리지 않는다. 비밀번호를 여기에 적지 않는다.
# ------------------------------------------------------------------

# 이 사이트 전용 PostgreSQL DB (docker-compose.yml 의 상자. 다른 시스템 DB 와 따로)
DATABASE_URL=postgres://dss_leave:여기에_비밀번호@localhost:5448/dss_leave

# docker compose 가 읽는 값. 위 DATABASE_URL 의 비밀번호와 같아야 한다.
# `npm run db:up` 이 --env-file .env.local 로 넘겨준다.
DSS_LEAVE_DB_PASSWORD=여기에_비밀번호

# 이 사이트가 쓸 포트.
# 사내 포트: 3000 A/S · 3100 통합 로그인 포털 · 3200 회사 홈페이지 · 3300 계측기 ·
#            3400 시너지 출석부 · 3500 개선요청 · 3600 PO/내자 · 3700 휴가 관리(이 시스템)
PORT=3700

# 세션 쿠키에 secure 를 붙일지.
# 사내망 HTTP 단계에서 true 로 켜면 쿠키가 저장되지 않아 로그인이 조용히 실패한다
# (포털까지 다녀와 돌아왔는데 다시 로그인 화면이다). HTTPS 를 붙인 뒤에 true 로 바꾼다.
SESSION_COOKIE_SECURE=false

# 세션 수명(시간). dss-auth SSO 세션의 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12

# ------------------------------------------------------------------
# 임시 로그인 — 통합 로그인이 막혔을 때 들어갈 뒷문
#
# 기본값은 반드시 꺼짐(false). 개발 중에만 true 로 둔다.
# 통합 로그인과 나란히 서고, 둘 다 결국 createSession(userId) 하나로 모인다.
# ------------------------------------------------------------------
DEV_FAKE_LOGIN_ENABLED=false

# ------------------------------------------------------------------
# DSS 통합 로그인 (dss-auth 포털, OIDC)
#
# 이름을 SSO_ 로 맞춘 이유: A/S · 계측기 · 개선요청 · PO/내자가 모두 같은
# 이름을 쓴다. Wi-Fi 가 바뀌어 IP 가 달라지면 여러 시스템을 같은 방식으로
# 고칠 수 있어야 한다.
#
# client_secret 에 NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 브라우저로 새어나간다.
# ------------------------------------------------------------------

# 포털 주소. ID 토큰의 iss 와 문자 단위로 같아야 한다(끝 슬래시는 코드가 떼어 낸다).
# "auto" 로 두면 이 기계의 사내망 IPv4 주소 + 3100 으로 푼다. "auto:3100" 도 같다.
SSO_ISSUER=auto

# 포털에 등록된 이 시스템의 식별자. ID 토큰의 aud 이기도 하다.
SSO_CLIENT_ID=dss-leave

# 토큰 교환에만 쓴다. 포털에서 발급받아 적는다.
SSO_CLIENT_SECRET=

# 🔴 포털에 등록한 값과 문자 단위로 같아야 한다. 경로는 /api/auth/sso/callback 이다.
# "auto" 로 두면 이 기계의 사내망 IPv4 주소 + PORT + 그 경로로 푼다.
# 요청(request.url)에서 만들어 쓰지 않는 이유는 src/lib/env.ts 에 적혀 있다.
SSO_REDIRECT_URI=auto

# 로그인 왕복 동안 state·nonce·PKCE 검증값을 나르는 쿠키(leave_sso_tx)의 서명 키.
# 32자 이상. 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SSO_TX_SECRET=
